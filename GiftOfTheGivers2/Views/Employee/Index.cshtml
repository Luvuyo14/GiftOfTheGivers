@{
    ViewData["Title"] = "Employee Dashboard";
}

<div class="container py-5">

    <!-- Header with Logo -->
    <div class="text-center mb-5">

        <img src="~/images/Logo.png"
             alt="Gift of the Givers Logo"
             style="max-height: 130px;" />

        <h1 class="fw-bold text-gotg">Employee Dashboard</h1>

        <p class="lead text-muted">
            Manage humanitarian projects and volunteers.
        </p>

    </div>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4">
            @ViewBag.Message
        </div>
    }

    <div class="row">

        <!-- Project Updates -->
        <div class="col-md-6 mb-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-gotg text-white py-3">

                    <h4 class="mb-0 fs-5 fw-bold">
                        Post Relief Project Update
                    </h4>

                </div>

                <div class="card-body p-4">

                    <form asp-controller="Employee"
                          asp-action="PostUpdate"
                          method="post">

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Project Name
                            </label>

                            <input type="text"
                                   name="projectName"
                                   class="form-control"
                                   placeholder="Enter project name"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Project Update
                            </label>

                            <textarea name="update"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Enter project update"
                                      required></textarea>

                        </div>

                        <button type="submit"
                                class="btn btn-gotg">

                            Post Update

                        </button>

                    </form>

                </div>

            </div>

        </div>


        <!-- Volunteer Management -->
        <div class="col-md-6 mb-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-gotg text-white py-3">

                    <h4 class="mb-0 fs-5 fw-bold">
                        Volunteer Sign-Ups
                    </h4>

                </div>

                <div class="card-body p-4">

                    <p class="text-muted">
                        Employees can review volunteer
                        registrations and their available skills.
                    </p>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle border">

                            <thead class="table-light">

                                <tr>
                                    <th class="fw-bold text-gotg">Name</th>
                                    <th class="fw-bold text-gotg">Skills</th>
                                    <th class="fw-bold text-gotg">Availability</th>
                                </tr>

                            </thead>

                            <tbody>

                                <tr>
                                    <td>Example Volunteer</td>
                                    <td>First Aid</td>
                                    <td>Weekends</td>
                                </tr>

                                <tr>
                                    <td>Example Volunteer 2</td>
                                    <td>Food Distribution</td>
                                    <td>Weekdays</td>
                                </tr>

                            </tbody>

                        </table>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Relief Projects -->

    <div class="card shadow-sm border-0 mt-3">

        <div class="card-header bg-gotg text-white py-3">

            <h4 class="mb-0 fs-5 fw-bold">
                Ongoing Relief Projects
            </h4>

        </div>

        <div class="card-body p-4">

            <div class="row">

                <div class="col-md-4 mb-3">

                    <div class="card border-0 bg-light h-100">

                        <div class="card-body p-3">

                            <h5 class="fw-bold text-gotg">Food Relief</h5>

                            <p class="text-muted small">
                                Distribution of food packages
                                to communities in need.
                            </p>

                            <span class="badge bg-success">
                                Active
                            </span>

                        </div>

                    </div>

                </div>

                <div class="col-md-4 mb-3">

                    <div class="card border-0 bg-light h-100">

                        <div class="card-body p-3">

                            <h5 class="fw-bold text-gotg">Medical Assistance</h5>

                            <p class="text-muted small">
                                Providing medical supplies and
                                healthcare support.
                            </p>

                            <span class="badge bg-success">
                                Active
                            </span>

                        </div>

                    </div>

                </div>

                <div class="col-md-4 mb-3">

                    <div class="card border-0 bg-light h-100">

                        <div class="card-body p-3">

                            <h5 class="fw-bold text-gotg">Disaster Relief</h5>

                            <p class="text-muted small">
                                Supporting communities affected
                                by disasters.
                            </p>

                            <span class="badge bg-warning text-dark">
                                In Progress
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="text-center mt-5">

        <a asp-controller="Account"
           asp-action="Logout"
           class="btn btn-outline-gotg">

            Logout

        </a>

    </div>

</div>