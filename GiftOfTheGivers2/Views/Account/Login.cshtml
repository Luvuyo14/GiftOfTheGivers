@model GiftOfTheGivers2.Models.LoginModel

@{
    ViewData["Title"] = "Login";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-6 col-lg-5">

            <!-- Logo Header -->
            <div class="text-center mb-4">
                <img src="~/images/Logo.png"
                     alt="Gift of the Givers Logo"
                     style="max-height: 110px;" />
            </div>

            <div class="card shadow-sm border-0">

                <div class="card-header bg-gotg text-white text-center py-3">
                    <h3 class="mb-0 fs-4">Gift of the Givers Login</h3>
                    <small class="text-white-50">Login to access your account</small>
                </div>

                <div class="card-body p-4">

                    <form asp-controller="Account"
                          asp-action="Login"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="Username"
                                   class="form-label fw-bold">
                                Username
                            </label>

                            <input asp-for="Username"
                                   class="form-control"
                                   placeholder="Enter username" />

                            <span asp-validation-for="Username"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Password"
                                   class="form-label fw-bold">
                                Password
                            </label>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Enter password" />

                            <span asp-validation-for="Password"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="d-grid mb-3">

                            <button type="submit"
                                    class="btn btn-gotg btn-lg">
                                Login
                            </button>

                        </div>

                    </form>

                    <!-- Prototype Login Details Box -->
                    <div class="alert alert-light border mt-4 mb-0">

                        <strong class="d-block text-gotg mb-1">Prototype Login Details</strong>

                        <small class="d-block text-muted">
                            <strong>Donor:</strong> donor / 1234
                        </small>

                        <small class="d-block text-muted">
                            <strong>Employee:</strong> employee / 1234
                        </small>

                    </div>

                </div>

            </div>

            <div class="text-center mt-3">
                <small class="text-muted">Don't have an account? <a asp-controller="Account" asp-action="Register" class="text-gotg fw-bold">Register as a Donor</a></small>
            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}