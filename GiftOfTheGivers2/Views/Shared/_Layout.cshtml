<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Gift of the Givers</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Website CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* Custom Gift of the Givers Green Theme */
        .bg-gotg {
            background-color: #054e29 !important;
        }

        .text-gotg {
            color: #054e29 !important;
        }

        /* Solid Brand Button */
        .btn-gotg {
            background-color: #054e29;
            color: #ffffff;
            border: 1px solid #054e29;
            transition: all 0.2s ease-in-out;
        }

        .btn-gotg:hover, .btn-gotg:focus {
            background-color: #03361c;
            color: #ffffff;
            border-color: #03361c;
        }

        /* Outline Brand Button */
        .btn-outline-gotg {
            background-color: transparent;
            color: #054e29;
            border: 1px solid #054e29;
            transition: all 0.2s ease-in-out;
        }

        .btn-outline-gotg:hover, .btn-outline-gotg:focus {
            background-color: #054e29;
            color: #ffffff;
        }

        .footer-link {
            color: #495057;
            transition: color 0.2s ease-in-out;
        }

        .footer-link:hover {
            color: #054e29 !important;
            text-decoration: underline !important;
        }
    </style>
</head>

<body>

    <!--  NAVIGATION  -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-gotg shadow-sm">
        <div class="container">

            <!-- Logo / Website Name -->
            <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Home" asp-action="Index">
                Gift of the Givers
            </a>

            <!-- Mobile Menu Button -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavigation"
                    aria-controls="mainNavigation"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navigation Links -->
            <div class="collapse navbar-collapse" id="mainNavigation">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <!-- HOME -->
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            Home
                        </a>
                    </li>

                    <!-- ABOUT -->
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="About">
                            About
                        </a>
                    </li>

                    <!-- DONATE -->
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Donation" asp-action="Index">
                            Donate
                        </a>
                    </li>

                    <!-- VOLUNTEER -->
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Volunteer" asp-action="Index">
                            Volunteer
                        </a>
                    </li>

                    <!-- CONTACT -->
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Contact">
                            Contact
                        </a>
                    </li>

                </ul>

                <!-- ACCOUNT LINKS -->
                <ul class="navbar-nav align-items-lg-center">

                    <!-- LOGIN -->
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Login">
                            Login
                        </a>
                    </li>

                    <!-- REGISTER -->
                    <li class="nav-item">
                        <a class="btn btn-outline-light ms-lg-2 px-3 py-1 mt-2 mt-lg-0" asp-controller="Account" asp-action="Register">
                            Register
                        </a>
                    </li>

                </ul>
            </div>

        </div>
    </nav>

    <!--  MAIN CONTENT  -->
    <main role="main">
        @RenderBody()
    </main>

    <!--  FOOTER  -->
    <footer class="border-top bg-light mt-5">
        <div class="container py-4">
            <div class="row">

                <!-- Organisation -->
                <div class="col-md-4 mb-3">
                    <h5 class="fw-bold text-gotg">Gift of the Givers</h5>
                    <p class="text-muted">
                        Serving humanity with compassion, dignity and hope.
                    </p>
                </div>

                <!-- Quick Links -->
                <div class="col-md-4 mb-3">
                    <h5 class="fw-bold text-gotg">Quick Links</h5>
                    <ul class="list-unstyled">
                        <li class="mb-1">
                            <a asp-controller="Home" asp-action="Index" class="footer-link text-decoration-none">Home</a>
                        </li>
                        <li class="mb-1">
                            <a asp-controller="Home" asp-action="About" class="footer-link text-decoration-none">About Us</a>
                        </li>
                        <li class="mb-1">
                            <a asp-controller="Donation" asp-action="Index" class="footer-link text-decoration-none">Donate</a>
                        </li>
                        <li class="mb-1">
                            <a asp-controller="Volunteer" asp-action="Index" class="footer-link text-decoration-none">Volunteer</a>
                        </li>
                        <li class="mb-1">
                            <a asp-controller="Home" asp-action="Contact" class="footer-link text-decoration-none">Contact</a>
                        </li>
                    </ul>
                </div>

                <!-- Contact -->
                <div class="col-md-4 mb-3">
                    <h5 class="fw-bold text-gotg">Contact</h5>
                    <p class="text-muted mb-1">Email: info@giftofthegivers.org</p>
                    <p class="text-muted mb-1">Phone: +27 11 828 3330</p>
                    <p class="text-muted">South Africa</p>
                </div>

            </div>

            <hr />

            <div class="text-center">
                <p class="text-muted mb-0">
                    &copy; @DateTime.Now.Year Gift of the Givers. All rights reserved.
                </p>
            </div>
        </div>
    </footer>

    <!--  JAVASCRIPT  -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Page-specific scripts -->
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>