@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Section -->
<div class="hero-section text-center">
    <div class="container py-5">

        <!-- Logo -->
        <img src="~/images/Logo.png"
             alt="Gift of the Givers Logo"
             style="max-height: 150px;" />

        <h1 class="display-4 fw-bold">
            Gift of the Givers
        </h1>

        <p class="lead">
            Serving humanity with compassion, dignity and hope.
        </p>

        <p class="mb-4">
            Support humanitarian projects and make a difference
            in communities affected by disasters and poverty.
        </p>

        <a asp-controller="Donation"
           asp-action="Index"
           class="btn btn-light text-gotg fw-bold btn-lg me-2 shadow-sm">
            Donate Now
        </a>

        <a asp-controller="Volunteer"
           asp-action="Index"
           class="btn btn-outline-light btn-lg">
            Become a Volunteer
        </a>

    </div>
</div>


<!-- Main Features -->
<div class="container py-5">

    <div class="text-center mb-5">

        <h2 class="fw-bold text-gotg">How You Can Help</h2>

        <p class="text-muted">
            There are many ways you can support humanitarian relief.
        </p>

    </div>


    <div class="row text-center">

        <!-- Donation -->
        <div class="col-md-4 mb-4">

            <div class="card shadow-sm h-100 border-0">

                <div class="card-body d-flex flex-column justify-content-between p-4">

                    <div>
                        <h3 class="fw-bold text-gotg mb-3">Donate</h3>

                        <p class="text-muted">
                            Make a once-off or recurring donation
                            to support humanitarian projects and
                            communities in need.
                        </p>
                    </div>

                    <a asp-controller="Donation"
                       asp-action="Index"
                       class="btn btn-gotg w-100 mt-3">

                        Donate Now

                    </a>

                </div>

            </div>

        </div>


        <!-- Volunteer -->
        <div class="col-md-4 mb-4">

            <div class="card shadow-sm h-100 border-0">

                <div class="card-body d-flex flex-column justify-content-between p-4">

                    <div>
                        <h3 class="fw-bold text-gotg mb-3">Volunteer</h3>

                        <p class="text-muted">
                            Register as a volunteer and use your
                            skills and time to help people affected
                            by disasters and poverty.
                        </p>
                    </div>

                    <a asp-controller="Volunteer"
                       asp-action="Index"
                       class="btn btn-gotg w-100 mt-3">

                        Volunteer

                    </a>

                </div>

            </div>

        </div>


        <!-- Projects -->
        <div class="col-md-4 mb-4">

            <div class="card shadow-sm h-100 border-0">

                <div class="card-body d-flex flex-column justify-content-between p-4">

                    <div>
                        <h3 class="fw-bold text-gotg mb-3">Relief Projects</h3>

                        <p class="text-muted">
                            Learn about humanitarian projects
                            providing food, medical assistance
                            and disaster relief.
                        </p>
                    </div>

                    <a asp-controller="Home"
                       asp-action="About"
                       class="btn btn-outline-gotg w-100 mt-3">

                        Learn More

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- Mission Section -->
<div class="container pb-5">

    <div class="card shadow-sm border-0">

        <div class="card-body text-center p-5">

            <h2 class="fw-bold text-gotg mb-3">Our Mission</h2>

            <p class="lead text-muted mb-4">
                Gift of the Givers works to provide humanitarian
                assistance to people and communities affected by
                disasters, poverty and emergencies.
            </p>

            <a asp-controller="Home"
               asp-action="About"
               class="btn btn-outline-gotg btn-lg px-4">

                About Us

            </a>

        </div>

    </div>

</div>