@{
    ViewData["Title"] = "About Us";
}

<div class="container py-5">

    <!-- Page Heading with Logo -->
    <div class="text-center mb-5">

        <img src="~/images/Logo.png"
             alt="Gift of the Givers Logo"
             style="max-height: 130px;" />

        <h1 class="fw-bold text-gotg">About Gift of the Givers</h1>

        <p class="lead text-muted">
            Providing humanitarian assistance where it is needed most.
        </p>

    </div>


    <!-- About Section -->
    <div class="row align-items-center mb-5">

        <div class="col-md-6 mb-4 mb-md-0">

            <h2 class="fw-bold text-gotg mb-3">Who We Are</h2>

            <p>
                Gift of the Givers is a humanitarian organisation
                focused on providing assistance to communities
                affected by disasters, poverty and emergencies.
            </p>

            <p class="text-muted">
                Through donations, volunteers and humanitarian
                relief projects, the organisation supports people
                and communities during times of need.
            </p>

        </div>


        <div class="col-md-6">

            <div class="card shadow-sm border-0">

                <div class="card-body text-center p-4">

                    <h3 class="fw-bold text-gotg mb-3">Our Purpose</h3>

                    <p class="mb-0 text-muted">
                        To provide practical humanitarian support
                        and help improve the lives of people
                        affected by difficult circumstances.
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- Mission and Vision -->
    <div class="row text-center mb-5">

        <div class="col-md-6 mb-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <h3 class="fw-bold text-gotg mb-3">Our Mission</h3>

                    <p class="text-muted mb-0">
                        To provide humanitarian assistance to
                        communities affected by disasters,
                        poverty and emergencies.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-6 mb-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <h3 class="fw-bold text-gotg mb-3">Our Vision</h3>

                    <p class="text-muted mb-0">
                        A world where people affected by
                        humanitarian crises can access the
                        support and resources they need.
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- Values -->
    <div class="text-center mb-4">

        <h2 class="fw-bold text-gotg">Our Values</h2>

        <p class="text-muted">
            The principles that guide our humanitarian work.
        </p>

    </div>


    <div class="row text-center">

        <div class="col-md-3 mb-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <h4 class="fw-bold text-gotg mb-2">Compassion</h4>

                    <p class="text-muted mb-0">
                        Caring for people and communities
                        in need.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-3 mb-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <h4 class="fw-bold text-gotg mb-2">Humanity</h4>

                    <p class="text-muted mb-0">
                        Putting people and their wellbeing
                        first.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-3 mb-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <h4 class="fw-bold text-gotg mb-2">Integrity</h4>

                    <p class="text-muted mb-0">
                        Acting responsibly and honestly
                        in our work.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-3 mb-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <h4 class="fw-bold text-gotg mb-2">Service</h4>

                    <p class="text-muted mb-0">
                        Working to make a positive difference
                        in people's lives.
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- Call to Action -->
    <div class="text-center mt-5 p-4 bg-white rounded shadow-sm">

        <h3 class="fw-bold text-gotg mb-2">Want to Make a Difference?</h3>

        <p class="text-muted mb-4">
            You can support humanitarian work by donating
            or becoming a volunteer.
        </p>

        <a asp-controller="Donation"
           asp-action="Index"
           class="btn btn-gotg btn-lg me-2">

            Donate Now

        </a>

        <a asp-controller="Volunteer"
           asp-action="Index"
           class="btn btn-outline-gotg btn-lg">

            Become a Volunteer

        </a>

    </div>

</div>