            <stringProp name="Argument.metadata">=</stringProp>
            <boolProp name="HTTPArgument.use_equals">true</boolProp>
            <stringProp name="Argument.name">DonationType</stringProp>
          </elementProp><elementProp name="Email" elementType="HTTPArgument">
